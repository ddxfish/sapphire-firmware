# Sapphire S3 satellites (ESP32-S3R8: 8 MB octal PSRAM, 16 MB flash): what every board here shares.
# Each board adds main/boards/<board>.defaults (its console, its camera sensors and their bus).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Size, not debug: smaller code frees internal RAM (the speaker board's lesson). NOT the
# flash-driver knobs: they starved esp-sr's model mmap there.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# NOTE no inline comment on the value line: the kconfig loader cannot parse it
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y


# esp-sr: no WakeNet (the wake word is ours), VAD and noise models in the model partition
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_NSN_NSNET2=y

# TLS: Sapphire's certificate is pinned when the settings hold it; without one
# the connection is not checked (a home network, and the setup script says so)
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# internal RAM is the scarce thing: the sound pipeline and WiFi both want it.
# With SPIRAM_TRY_ALLOCATE_WIFI_LWIP the TX buffers are STATIC (a DYNAMIC_TX line is dead config):
# 16 of them were 25.6 KB of internal DMA RAM; 8 are plenty with TCP_SND_BUF at 4 segments and
# CACHE_TX queueing the rest by reference (the config scout, 2026-11-02). RX stays 8: the floor with AMPDU is 6.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# The card: long file names (sapphire_2026-10-06_030000_daily.sapphirebak)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# a new program over the air is on trial until it says it is fine (ota.c)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# where the time goes: console `tasks`, `cpu` in /health (stats.c)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# LVGL 9 for the glass: its heap on PSRAM through lv_mem_psram.c, 16 bit color, the fonts
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_STRESS=n
CONFIG_LV_USE_DEMO_MUSIC=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_THORVG_INTERNAL=n
CONFIG_LV_USE_VECTOR_GRAPHIC=n
# no image caches: ui.c reuses one descriptor per image and relies on this
CONFIG_LV_CACHE_DEF_SIZE=0
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=0

# the eye: the sensors either board has are named in main/boards/<board>.defaults (with their SCCB port);
# the rest are off everywhere; the driver's task on core 1 with the glass
CONFIG_OV2640_SUPPORT=y
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV3640_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_GC0308_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_CAMERA_CORE1=y
# a crash keeps its story: the core dump goes to its own partition, lastwords.c reads the summary
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# the web server's sockets must leave room for the board's own calls to Sapphire
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_CJSON_NESTING_LIMIT=16
# nothing here speaks IPv6: a few KB of RAM and 39 KB of flash, and the MSS goes to 1460
CONFIG_LWIP_IPV6=n

# The log ring (logring.c) is found again after a reset: the boot memory test would write over it (2026-11-05)
CONFIG_SPIRAM_MEMTEST=n
