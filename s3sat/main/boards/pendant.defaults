# The pendant (Elecrow AI Camera board): the console is UART0 through the CH340K (there is no native
# USB on this board, so no secondary console either); the eye is a GC2145 (Elecrow's part) or an OV2640
# (its other build), SCCB on the camera's own two pins, a second I2C port.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_GC2145_SUPPORT=y
CONFIG_OV3660_SUPPORT=n
CONFIG_OV5640_SUPPORT=n
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
